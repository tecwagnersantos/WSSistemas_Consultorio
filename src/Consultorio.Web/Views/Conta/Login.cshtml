@model LoginVM
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    ViewData["Title"] = T["Entrar"].Value;
    ViewData["ClasseBody"] = "pagina-login";
    Layout = "_LayoutSimples";
}
<div class="login-caixa">
    <div class="login-marca">
        <img class="logo-empresa" src="~/img/logo-ws.png" alt="WS Sistemas" width="220" />
        <h1>@(Config["Consultorio:Nome"] ?? T["Consultório Médico"].Value)</h1>
        <p>@T["Agenda, prontuário e relatórios"]</p>
    </div>
    <form method="post" asp-action="Login" class="formulario">
        <partial name="_ResumoErros" />
        <input type="hidden" asp-for="ReturnUrl" />
        <label class="campo">
            <span>@T["E-mail"]</span>
            <input asp-for="Email" type="email" autocomplete="username" autofocus required />
        </label>
        <label class="campo">
            <span>@T["Senha"]</span>
            <input asp-for="Senha" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit" class="btn btn-primario btn-bloco">@T["Entrar"]</button>
    </form>
    @if (Config.GetValue("Demonstracao:Habilitado", true))
    {
        <div class="login-demonstracao">
            <span>@T["Ainda não é cliente?"]</span>
            <a class="btn btn-secundario btn-bloco" asp-action="Demonstracao">@T["Experimente grátis por {0} dias", Config.GetValue("Demonstracao:Dias", 15)]</a>
        </div>
    }
    <p class="login-rodape">@T["Acesso restrito. As operações no prontuário são registradas (LGPD)."]</p>
</div>

<?xml version="1.0" encoding="utf-8"?>
<!-- Publicação no IIS (ASP.NET Core Module V2, in-process). Requer o ASP.NET Core 9 Hosting Bundle no servidor. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Envio de anexos do prontuário: até 100 MB por envio (o limite por arquivo é Anexos:TamanhoMaximoMB) -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Consultorio.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Defina ConnectionStrings__Consultorio aqui ou nas variáveis do Application Pool -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
